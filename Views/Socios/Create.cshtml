@model ClubSenderismo.Models.Socio
@{
    ViewData["Title"] = "Inscripción";
    var rutas = (List<ClubSenderismo.Models.Ruta>)ViewBag.Rutas;
    var niveles = new[] { "Principiante", "Intermedio", "Avanzado" };
    var intereses = new[] { "Fotografía de naturaleza", "Camping", "Caminatas nocturnas" };
}

<section id="contacto" class="py-5">
    <div class="container">
        <h2 class="titulo">Formulario de inscripción</h2>

        <div class="row">
            <div class="col-md-6">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre completo:</label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej. Laura Gómez">
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label">Correo electrónico:</label>
                        <input asp-for="Correo" class="form-control" placeholder="tucorreo@ejemplo.com">
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefono" class="form-label">Teléfono:</label>
                        <input asp-for="Telefono" type="tel" class="form-control" placeholder="Ej. 300 123 4567">
                    </div>

                    <div class="mb-3">
                        <label asp-for="FechaNacimiento" class="form-label">Fecha de nacimiento:</label>
                        <input asp-for="FechaNacimiento" type="date" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Edad" class="form-label">Edad:</label>
                        <input asp-for="Edad" type="number" class="form-control" placeholder="Ej. 28">
                        <span asp-validation-for="Edad" class="text-danger"></span>
                    </div>

                    <p class="mb-1">Nivel de experiencia:</p>
                    @for (int i = 0; i < niveles.Length; i++)
                    {
                        <div class="form-check">
                            <input type="radio" id="nivel-@i" name="Nivel" value="@niveles[i]"
                                   class="form-check-input" checked="@(Model.Nivel == niveles[i])">
                            <label for="nivel-@i" class="form-check-label">@niveles[i]</label>
                        </div>
                    }
                    <span asp-validation-for="Nivel" class="text-danger d-block mb-3"></span>

                    <div class="mb-3">
                        <label asp-for="Ruta" class="form-label">Ruta de interés:</label>
                        <select asp-for="Ruta" class="form-select">
                            <option value="">-- Selecciona --</option>
                            @foreach (var r in rutas)
                            {
                                <option value="@r.Nombre">@r.Nombre</option>
                            }
                        </select>
                    </div>

                    <p class="mb-1">Intereses:</p>
                    @for (int i = 0; i < intereses.Length; i++)
                    {
                        <div class="form-check @(i == intereses.Length - 1 ? "mb-3" : "")">
                            <input type="checkbox" id="interes-@i" name="Intereses" value="@intereses[i]"
                                   class="form-check-input" checked="@Model.Intereses.Contains(intereses[i])">
                            <label for="interes-@i" class="form-check-label">@intereses[i]</label>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Comentarios" class="form-label">Comentarios:</label>
                        <textarea asp-for="Comentarios" class="form-control" rows="4"
                                  placeholder="Cuéntanos si tienes alguna condición médica relevante"></textarea>
                    </div>

                    <div class="form-check mb-1">
                        <input asp-for="AceptoReglamento" class="form-check-input">
                        <label asp-for="AceptoReglamento" class="form-check-label">Acepto el reglamento del club</label>
                    </div>
                    <span asp-validation-for="AceptoReglamento" class="text-danger d-block mb-3"></span>

                    <button type="submit" class="btn btn-success">Enviar inscripción</button>
                </form>
            </div>

            <div class="col-md-6">
                <h3>Socios inscritos: @ViewBag.TotalSocios</h3>
                <a class="btn btn-outline-success btn-sm" asp-action="Index">Ver lista completa</a>
            </div>
        </div>
    </div>
</section>