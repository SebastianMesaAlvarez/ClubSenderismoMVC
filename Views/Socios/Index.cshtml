@model List<ClubSenderismo.Models.Socio>
@{ ViewData["Title"] = "Socios"; }

<section class="py-5">
    <div class="container">
        <h2 class="titulo">Socios inscritos: @Model.Count</h2>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }

        <a class="btn btn-success btn-sm mb-3" asp-action="Create">Nueva inscripción</a>

        @if (Model.Count == 0)
        {
            <p class="text-muted">Aún no hay socios inscritos.</p>
        }

        <ul class="list-group">
            @foreach (var s in Model)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>
                        <strong>@s.Nombre</strong><br>
                        @s.Correo - @s.Nivel<br>
                        Ruta: @(string.IsNullOrEmpty(s.Ruta) ? "Sin elegir" : s.Ruta)
                        @if (s.Intereses.Any())
                        {
                            <br />@("Intereses: " + string.Join(", ", s.Intereses))
                        }
                    </span>
                    <form asp-action="Delete" asp-route-id="@s.Id" method="post">
                        <button class="btn btn-danger btn-sm" type="submit">Quitar</button>
                    </form>
                </li>
            }
        </ul>
    </div>
</section>